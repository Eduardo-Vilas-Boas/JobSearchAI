# The guard review page (src/jobfit/ui/guard_review.py), for docker compose.
# Installs only the `ui` dependency group, not the ingestion pipeline's models.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.11.6 /uv /bin/uv

WORKDIR /app
ENV UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    PYTHONPATH=/app/src

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --only-group ui --no-install-project

COPY src ./src
COPY config ./config

EXPOSE 8501
CMD ["uv", "run", "--no-sync", "streamlit", "run", "src/jobfit/ui/guard_review.py", \
     "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
