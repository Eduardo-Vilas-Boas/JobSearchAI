{
  "manifest_version": 3,
  "name": "jobfit capture",
  "version": "0.2.0",
  "description": "Shows what jobfit reads from the job posting open in this tab, and saves it to the local pipeline.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "scripting", "activeTab"],
  "host_permissions": ["https://www.linkedin.com/*", "http://127.0.0.1:8765/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open the jobfit side panel" }
}
